    with open(DB_FILE, "w") as f:
        json.dump(data, f, indent=4)

# --- APP CONFIGURATION & STYLING ---
st.set_page_config(page_title="Pro Quiz Application", page_icon="🎯", layout="centered")

# Custom CSS for Modern UI
